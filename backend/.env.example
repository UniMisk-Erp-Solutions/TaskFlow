# Copy to .env and fill values. Used by Express API + web push.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=http://localhost:5173
PORT=5000

# Web Push (VAPID). Generate: npx web-push generate-vapid-keys
# Subject is usually a mailto: or your site URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
