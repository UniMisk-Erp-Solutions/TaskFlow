# Use a URL every browser can reach. For local Supabase + LAN testing, use your
# machine's LAN IP (e.g. http://192.168.1.10:54321/...), not localhost — otherwise
# other devices resolve "localhost" to themselves and see empty data / errors.
VITE_API_URL=https://your-project-ref.supabase.co/functions/v1/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional — Google Calendar OAuth (Web app client). When set, the Calendar
# page shows a "Connect Google Calendar" button and the New Meeting modal
# shows a "Also add to my Google Calendar" toggle. See docs/GOOGLE_CALENDAR.md
# for the Google Cloud Console setup.
VITE_GOOGLE_CLIENT_ID=

# Cloud maintenance gate (separate "Maintenance Control" Supabase project).
# Public values — the anon key of that project. When unset, the gate fails open
# and the app renders normally. Also set these in Vercel's env vars.
VITE_STATUS_URL=https://your-maintenance-project-ref.supabase.co
VITE_STATUS_KEY=your-maintenance-project-anon-key
